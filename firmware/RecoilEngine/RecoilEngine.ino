#define JITTER_DRIFT_AMP_PX      0.08f 
#define JITTER_DRIFT_ALPHA       0.06f 
#define EMA_SMOOTH_ALPHA         0.30f
static_assert(EMA_SMOOTH_ALPHA > 0.0f && EMA_SMOOTH_ALPHA <= 1.0f,
              "EMA alpha must be in (0,1]"); 

#define FATIGUE_FRESH_MULT       0.60f 
