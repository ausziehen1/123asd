#include <cmath>
#include <stdint.h>
#include "EngineSafety.h"

#if !defined(CONFIG_IDF_TARGET_ESP32S3) || ARDUINO_USB_MODE != 0
#error "Requires ESP32-S3 native USB OTG (USB Mode: USB-OTG / TinyUSB)"
#endif
#if CONFIG_FREERTOS_UNICORE
#error "This firmware requires both ESP32-S3 cores"
#endif

// R3.2: selected deep optimizations with switchable math changes.
// R3.1 remains the calibration reference. Hardware validation required.
// --- АППАРАТНЫЕ ПИНЫ (Все замыкаются на GND) ---
#define TRIGGER_PIN        5   // Сигнал с микрика ЛКМ (Детектор удержания, без отправки клика)
#define FN_BUTTON_PIN      6   // Кнопка функций: Двойной клик (ON/OFF), Зажатие (Вариация 1/2)
#define BTN_PROF_UP_PIN    7   // Кнопка [+1] к множителю
#define BTN_PROF_DOWN_PIN  8   // Кнопка [-1] к множителю
#define RGB_LED_PIN        48  // Встроенный RGB светодиод WS2812

// ================= ЕДИНЫЙ БЛОК ТОНКОЙ КАЛИБРОВКИ =================
// 1. Разделение Тап / Зажим:
#define TAP_WINDOW_US            50000ULL // Длительность окна одиночного клика (40000..65000 мкс)
#define TAP_CURVE_POWER          3        // Крутизна подавления тапа: 2 (квадрат), 3 (куб), 4 (жесткий отсев)
#define TAP_AUTO_CATCHUP         1        // 1 = Авто-компенсация потери высоты на 2-й половине 1-й пули, 0 = Выкл
#define TAP_SPRINGBACK_ENABLE    1        // 1 = Возвращать курсор назад, если кнопка отпущена во время тапа
#define TAP_SPRINGBACK_TIME_US  15000ULL // Плавный возврат за 15 мс, без ожидания
#define COOLDOWN_STEP_MS        45ULL    // Исходный темп восстановления: один шаг за 45 мс
#define HID_BUSY_DROP_US        25000ULL // Не отдавать накопленную историю после долгой USB-паузы

// Ревизия R2: надёжность без изменения математической модели.
#define ENGINE_DIAGNOSTICS       1        // 1 = статистика в RAM (без печати в Core 1)
#define ENGINE_LATE_THRESHOLD_US 50ULL    // Считать существенным опоздание >= 50 мкс
#define ENGINE_DIAG_UART         0        // 1 = печать из Core 0 через UART0, НЕ USB CDC
#define ENGINE_TASK_WDT         1        // 1 = попытка подписки EngineTask на уже запущенный TWDT
#define CONTROL_DEBOUNCE_MS     25UL     // FN, UP, DOWN: stable electrical state for 25 ms
#define FN_HOLD_MS             600UL    // FN long hold: CLOSE / LONG
#define FN_MIN_CLICK_MS        30UL     // Shorter FN taps are not commands
#define FN_DOUBLE_WINDOW_MS   250UL    // Double FN: ON / OFF
// Для эксперимента можно отключить Spring-Back на warm-start (1 сохраняет поведение R1).
#define SPRINGBACK_ON_WARM_TAP  1

// R3.2 options: disable any independent experiment to compare with R3.1.
#ifndef R32_SPLINE_CACHE
#define R32_SPLINE_CACHE          1   // polynomial coefficients once per segment
#endif
#ifndef R32_ABSOLUTE_SCHEDULER
#define R32_ABSOLUTE_SCHEDULER    1   // anchored deadlines; timer wake + short spin tail
#endif
#ifndef R32_TIME_NORMALIZATION
#define R32_TIME_NORMALIZATION   1   // time-scaled EMA/drift/mirror/micro noise
#endif
#ifndef R32_WRAP_TANGENT_FIX
#define R32_WRAP_TANGENT_FIX     1   // in sustain loop, preceding node of 18 = 29
#endif
#ifndef R32_DETERMINISTIC_RNG
#define R32_DETERMINISTIC_RNG     0   // 1 for isolated bench replay ONLY, not normal usage
#endif
#ifndef R32_RNG_TEST_SEED
#define R32_RNG_TEST_SEED        0xC001CAFEu
#endif
#ifndef R32_USB_COMPLETION_HOOK
#define R32_USB_COMPLETION_HOOK  0   // 1 ONLY with an external Arduino-core hook adapter
#endif
#ifndef R32_AVOID_CONSECUTIVE_PATTERN
#define R32_AVOID_CONSECUTIVE_PATTERN 1 // new cold start differs from previous cold pattern
#endif

// 2. Инерция остывания отдачи при быстрых прокликах (Burst Cooldown):
#define SPRAY_COOLDOWN_MS        320      // Время полного остывания прицела после очереди (мс)

// 3. Баланс геометрии ("Подкид - Основа - Хвост"):
#define PATTERN_COMPRESSION      0.38f    // 0.25f = почти прямая, 0.38f = баланс, 1.0f = оригинал

// --- ТАЙМИНГИ И ЧАСТОТА ДВИЖКА ---
#define SHOTS_PER_SPRAY          30
#define LOOP_START_SHOT          18
#define NUM_PATTERNS             40
#define BASE_SHOT_INTERVAL_US    100000ULL // Базовый интервал сегмента: 100 мс
#define INTERVAL_JITTER_US       6000.0f   // Девиация интервала сегмента: +-6 мс

#define BASE_TICK_US             1000ULL   // Базовый период опроса USB HID: 1000 мкс (1000 Гц)
#define USB_POLL_JITTER_US       50.0f     // Джиттер периода опроса USB: +-50 мкс (950..1050 мкс)

#define DEBOUNCE_TRIGGER_US      3000ULL   // Симметричный антидребезг входа триггера: 3 мс

// --- СКАЛЯРЫ БАЛЛИСТИКИ ---
#define BASE_PIXEL_SCALE_X       1.20f 
#define BASE_PIXEL_SCALE_Y       1.68f 

#define CORE_ANCHOR_CLOSE_Y      4.20f 
#define CORE_ANCHOR_LONG_Y       4.85f 

static_assert((BASE_SHOT_INTERVAL_US - (uint64_t)INTERVAL_JITTER_US) > TAP_WINDOW_US,
              "TAP_WINDOW_US must be shorter than the shortest shot interval");
static_assert(TAP_SPRINGBACK_TIME_US > 0, "Spring-back duration must be >0");
static_assert(LOOP_START_SHOT > 0 && LOOP_START_SHOT < SHOTS_PER_SPRAY, "Invalid sustain loop");
static_assert(BASE_TICK_US == 1000ULL, "R3.2 normalization table is calibrated for 1ms nominal ticks");
static_assert(ENGINE_DIAG_UART == 0 || ENGINE_DIAGNOSTICS == 1,
              "ENGINE_DIAG_UART needs ENGINE_DIAGNOSTICS");
static_assert(TAP_CURVE_POWER == 2 || TAP_CURVE_POWER == 3 || TAP_CURVE_POWER == 4,
              "TAP_CURVE_POWER must be 2, 3, or 4");

// --- КАЛИБРОВКА ТРЕМОРА И УСТАЛОСТИ ---
