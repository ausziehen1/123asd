// ================= МАТЕМАТИЧЕСКОЕ ЯДРО =================

static inline float __attribute__((always_inline)) fastClampF(float val, float low, float high) {
    return (val < low) ? low : ((val > high) ? high : val);
}

static inline int __attribute__((always_inline)) fastClampI(int val, int low, int high) {
    return (val < low) ? low : ((val > high) ? high : val);
}

// Default: original ESP hardware RNG. Optional reproducible stream for host/bench tests.
// Single writer: all calls are from EngineTask, not ControlTask.
static inline uint32_t recoilRandomBits() {
#if R32_DETERMINISTIC_RNG
    static uint32_t state = R32_RNG_TEST_SEED;
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;
    return state;
#else
    return esp_random();
#endif
}

static inline int r32ChooseColdPattern(int lastPattern) {
#if R32_AVOID_CONSECUTIVE_PATTERN
    if (lastPattern >= 0 && lastPattern < NUM_PATTERNS) {
        const int candidate = (int)(recoilRandomBits() % (NUM_PATTERNS - 1));
        return candidate + (candidate >= lastPattern ? 1 : 0);
    }
#endif
    return (int)(recoilRandomBits() % NUM_PATTERNS);
}

static inline float __attribute__((always_inline)) randomCenteredFloat() {
    uint32_t rnd = recoilRandomBits() & 0x00FFFFFF;
    return ((float)rnd * (1.0f / 8388607.5f)) - 1.0f;
}

static inline uint64_t __attribute__((always_inline)) generateNextIntervalUs() {
    int32_t jitterUs = (int32_t)(randomCenteredFloat() * INTERVAL_JITTER_US);
    return (uint64_t)((int64_t)BASE_SHOT_INTERVAL_US + jitterUs);
}

static inline uint64_t __attribute__((always_inline)) generateNextTickDurationUs() {
    int32_t pollJitterUs = (int32_t)(randomCenteredFloat() * USB_POLL_JITTER_US);
    return (uint64_t)((int64_t)BASE_TICK_US + pollJitterUs);
}

static inline float __attribute__((always_inline)) computeMuscleFatigueFactor(int currentShot, float t, bool inSustainLoop) {
    if (inSustainLoop) {
        return FATIGUE_MAX_MULT;
    }
    float pos = (float)currentShot + fastClampF(t, 0.0f, 1.0f);
    if (pos < 4.0f) {
        return FATIGUE_FRESH_MULT;
    }
    float progress = fastClampF((pos - 4.0f) * (1.0f / (float)(SHOTS_PER_SPRAY - 1 - 4)), 0.0f, 1.0f);
    return FATIGUE_FRESH_MULT + progress * (FATIGUE_MAX_MULT - FATIGUE_FRESH_MULT);
}

static inline int __attribute__((always_inline)) getCycleShotIndex(int baseShot, int offset) {
    int idx = baseShot + offset;
    if (idx < 0) {
        return 0;
    }
    if (idx >= SHOTS_PER_SPRAY) {
        int loopLen = SHOTS_PER_SPRAY - LOOP_START_SHOT;
        idx = LOOP_START_SHOT + ((idx - LOOP_START_SHOT) % loopLen);
    }
    return fastClampI(idx, 0, SHOTS_PER_SPRAY - 1);
}

static inline BulletTarget __attribute__((always_inline)) getBalancedNode(
        const BulletTarget (*bank)[SHOTS_PER_SPRAY],
        int patternIdx,
        int shotIdx,
        float coreAnchorY) {
    BulletTarget pt = bank[patternIdx][shotIdx];

    float rawY = pt.y;
    if (shotIdx == 0) {
        rawY = 0.5f * (pt.y + bank[patternIdx][1].y);
    }

    pt.y = coreAnchorY + (rawY - coreAnchorY) * PATTERN_COMPRESSION;
    return pt;
}

static inline BulletTarget __attribute__((always_inline)) evalCatmullRom(
        const BulletTarget& p0,
        const BulletTarget& p1,
        const BulletTarget& p2,
        const BulletTarget& p3,
        float t) {
    t = fastClampF(t, 0.0f, 1.0f);
    float t2 = t * t;
    float t3 = t2 * t;

    BulletTarget out;
    out.x = 0.5f * ((2.0f * p1.x) +
                    (-p0.x + p2.x) * t +
                    (2.0f * p0.x - 5.0f * p1.x + 4.0f * p2.x - p3.x) * t2 +
                    (-p0.x + 3.0f * p1.x - 3.0f * p2.x + p3.x) * t3);

    out.y = 0.5f * ((2.0f * p1.y) +
                    (-p0.y + p2.y) * t +
                    (2.0f * p0.y - 5.0f * p1.y + 4.0f * p2.y - p3.y) * t2 +
                    (-p0.y + 3.0f * p1.y - 3.0f * p2.y + p3.y) * t3);
    return out;
}


// C1-непрерывное распределение возвратного смещения по времени.

// -------- R3.2: time domain normalization --------
// At EXACTLY 1000 us all coefficients equal R3.1, including noise amplitude.
// OU drift: rho(dt)=(1-a)^(dt/1000); stationary variance kept by scaling innovation.
// This preserves drift-state variance/correlation, NOT exact bitwise HID output.
struct R32TimeDynamics {
    float emaAlpha, mirrorAlpha, driftRho, driftInnovation, microScale;
};
static constexpr uint32_t R32_DT_TABLE_MIN_US = 750;
static constexpr uint32_t R32_DT_TABLE_MAX_US = 1250;
static constexpr uint32_t R32_DT_TABLE_STEP_US = 25;
static constexpr size_t R32_DT_TABLE_LEN =
    (R32_DT_TABLE_MAX_US - R32_DT_TABLE_MIN_US) / R32_DT_TABLE_STEP_US + 1;
static R32TimeDynamics g_r32DynamicsTable[R32_DT_TABLE_LEN];

static inline R32TimeDynamics r32TimeDynamicsRaw(uint32_t dtUs) {
    const float ratio = (float)dtUs / (float)BASE_TICK_US;
    const float emaRho = powf(1.0f - EMA_SMOOTH_ALPHA, ratio);
    const float mirrorRho = powf(1.0f - 0.02f, ratio);
    const float driftRho = powf(1.0f - JITTER_DRIFT_ALPHA, ratio);
    const float stationaryVarFactor = JITTER_DRIFT_ALPHA / (2.0f - JITTER_DRIFT_ALPHA);
    R32TimeDynamics out;
    out.emaAlpha = 1.0f - emaRho;
    out.mirrorAlpha = 1.0f - mirrorRho;
    out.driftRho = driftRho;
    out.driftInnovation = sqrtf(fmaxf(0.0f, stationaryVarFactor * (1.0f - driftRho * driftRho)));
    out.microScale = sqrtf(ratio); // micro jitter is an increment per tick, scale like diffusion
    return out;
}

static void r32InitDynamics() {
#if R32_TIME_NORMALIZATION
    for (size_t i=0;i<R32_DT_TABLE_LEN;++i)
        g_r32DynamicsTable[i] = r32TimeDynamicsRaw(R32_DT_TABLE_MIN_US + (uint32_t)i * R32_DT_TABLE_STEP_US);
#endif
}

static inline R32TimeDynamics r32TimeDynamics(uint32_t dtUs) {
#if R32_TIME_NORMALIZATION
    if (dtUs == BASE_TICK_US) return {EMA_SMOOTH_ALPHA, 0.02f,
        1.0f - JITTER_DRIFT_ALPHA, JITTER_DRIFT_ALPHA, 1.0f};
    if (dtUs >= R32_DT_TABLE_MIN_US && dtUs <= R32_DT_TABLE_MAX_US) {
        const uint32_t offset = dtUs - R32_DT_TABLE_MIN_US;
        const uint32_t idx = offset / R32_DT_TABLE_STEP_US;
        const float weight = (float)(offset % R32_DT_TABLE_STEP_US) / (float)R32_DT_TABLE_STEP_US;
        if (idx >= R32_DT_TABLE_LEN - 1 || weight == 0.0f) return g_r32DynamicsTable[idx];
        const auto &a = g_r32DynamicsTable[idx], &b = g_r32DynamicsTable[idx+1];
        return { a.emaAlpha + (b.emaAlpha-a.emaAlpha)*weight,
                 a.mirrorAlpha + (b.mirrorAlpha-a.mirrorAlpha)*weight,
                 a.driftRho + (b.driftRho-a.driftRho)*weight,
                 a.driftInnovation + (b.driftInnovation-a.driftInnovation)*weight,
                 a.microScale + (b.microScale-a.microScale)*weight };
    }
    // Large timing interruptions are already capped at 5000us in the engine.
    return r32TimeDynamicsRaw(dtUs);
#else
    (void)dtUs;
    return {EMA_SMOOTH_ALPHA, 0.02f, 1.0f - JITTER_DRIFT_ALPHA, JITTER_DRIFT_ALPHA, 1.0f};
#endif
}

// -------- R3.2: Catmull-Rom polynomial cached per shot, no change to pattern data --------
struct R32CachedSpline {
    int shot=-1, pattern=-1, mode=-1;
    bool sustain=false;
    BulletTarget a{}, b{}, c{}, d{};
};

static inline int r32NeighborIndex(int shot, int offset, bool sustain) {
#if R32_WRAP_TANGENT_FIX
    if (sustain && shot == LOOP_START_SHOT && offset == -1)
        return SHOTS_PER_SPRAY - 1;
#else
    (void)sustain;
#endif
    return getCycleShotIndex(shot, offset);
}

static inline void r32PrepareSpline(R32CachedSpline &cache, int shot, int pattern,
                                    CombatMode mode, bool sustain,
                                    const BulletTarget (*bank)[SHOTS_PER_SPRAY], float anchorY) {
    if (cache.shot==shot && cache.pattern==pattern && cache.mode==(int)mode && cache.sustain==sustain)
        return;
    const BulletTarget p0=getBalancedNode(bank,pattern,r32NeighborIndex(shot,-1,sustain),anchorY);
    const BulletTarget p1=getBalancedNode(bank,pattern,r32NeighborIndex(shot, 0,sustain),anchorY);
    const BulletTarget p2=getBalancedNode(bank,pattern,r32NeighborIndex(shot,+1,sustain),anchorY);
    const BulletTarget p3=getBalancedNode(bank,pattern,r32NeighborIndex(shot,+2,sustain),anchorY);
    cache.a = p1;
    cache.b = {0.5f*(-p0.x+p2.x), 0.5f*(-p0.y+p2.y)};
    cache.c = {0.5f*(2.0f*p0.x-5.0f*p1.x+4.0f*p2.x-p3.x),
               0.5f*(2.0f*p0.y-5.0f*p1.y+4.0f*p2.y-p3.y)};
    cache.d = {0.5f*(-p0.x+3.0f*p1.x-3.0f*p2.x+p3.x),
               0.5f*(-p0.y+3.0f*p1.y-3.0f*p2.y+p3.y)};
    cache.shot=shot; cache.pattern=pattern; cache.mode=(int)mode; cache.sustain=sustain;
}

static inline BulletTarget r32EvalSpline(const R32CachedSpline &c, float t) {
    t = fastClampF(t,0.0f,1.0f);
    // Horner polynomial, 3 multiplies per coordinate; tiny IEEE754 rounding differences.
    return {((c.d.x*t+c.c.x)*t+c.b.x)*t+c.a.x,
            ((c.d.y*t+c.c.y)*t+c.b.y)*t+c.a.y};
}

static inline float easeCubic(float t) {
    t = fastClampF(t, 0.0f, 1.0f);
    return t * t * (3.0f - 2.0f * t);
}

// ================= УПРАВЛЕНИЕ LED И NVS (CORE 0) =================

// ============== LED arbitration (only Core 0 can write WS2812) ==============
// Priority: command confirmation blink > globally OFF > active engine >
// profile preview > idle. Keeping a last-color cache prevents repetitive writes.
uint8_t ledLastR = 255, ledLastG = 255, ledLastB = 255;
void writeLedIfChanged(uint8_t r, uint8_t g, uint8_t b) {
    if (r == ledLastR && g == ledLastG && b == ledLastB) return;
    ledLastR = r; ledLastG = g; ledLastB = b;
    neopixelWrite(RGB_LED_PIN, r, g, b);
}

void getProfileColor(int index, uint8_t& r, uint8_t& g, uint8_t& b) {
    index = constrain(index, 0, 14);
    uint8_t hue = map(index, 0, 14, 96, 0);
    if (hue < 32) {
        r = 40; g = map(hue, 0, 32, 0, 40); b = 0;
    } else if (hue < 64) {
        r = map(hue, 32, 64, 40, 10); g = 40; b = 0;
    } else {
        r = 0; g = 40; b = map(hue, 64, 96, 0, 20);
    }
}

void setProfileColor(int index) {
    (void)index; // Color is rendered later from the latest coherent settings.
    ledResetTime = millis() + 2000UL;
    ledActive = true;
}

void startBlink(uint8_t r, uint8_t g, uint8_t b, uint8_t blinks) {
    blinker.active = true;
    blinker.r = r; blinker.g = g; blinker.b = b;
    blinker.maxBlinks = blinks;
    blinker.count = 0;
    blinker.stateOn = true;
    blinker.nextToggle = millis() + 90UL;
    writeLedIfChanged(r, g, b);
}

void updateBlinker(unsigned long now) {
    if (!blinker.active) return;
    if ((int32_t)(now - blinker.nextToggle) < 0) return;
    if (blinker.stateOn) {
        writeLedIfChanged(0, 0, 0);
        blinker.stateOn = false;
        blinker.count++;
        if (blinker.count >= blinker.maxBlinks) {
            blinker.active = false;
            // Return to current state; no stale shoot LED events survive here.
            if (readControl().enabled) setProfileColor(readControl().profile);
            return;
        }
    } else {
        writeLedIfChanged(blinker.r, blinker.g, blinker.b);
        blinker.stateOn = true;
    }
    blinker.nextToggle = now + 90UL;
}

void renderLed(unsigned long now) {
    // Detect release even if it happened while a command blink was playing.
    static uint8_t previousEngineLedState = ENGINE_LED_IDLE;
    const uint8_t engineState = g_engineLedState.load(std::memory_order_relaxed);
    if (previousEngineLedState != ENGINE_LED_IDLE && engineState == ENGINE_LED_IDLE) {
        if (readControl().enabled) setProfileColor(readControl().profile);
    }
    previousEngineLedState = engineState;

    if (g_engineFault.load(std::memory_order_acquire)) {
        writeLedIfChanged(((now / 150UL) & 1u) ? 80 : 0, 0, 0);
        return;
    }
    // Highest priority: deliberate feedback for the physical FN command.
    if (blinker.active) return;
    if (settingsSaveFailed) {
        const bool on = ((now / 250UL) & 1u) != 0;
        writeLedIfChanged(on ? 60 : 0, on ? 20 : 0, 0);
    } else if (!readControl().enabled) {
        writeLedIfChanged(0, 0, 0);
    } else if (engineState == ENGINE_LED_CLOSE) {
        writeLedIfChanged(0, 0, 70);
    } else if (engineState == ENGINE_LED_LONG) {
        writeLedIfChanged(60, 0, 70);
    } else if (ledActive && (int32_t)(now - ledResetTime) < 0) {
        uint8_t r = 0, g = 0, b = 0;
        getProfileColor(readControl().profile, r, g, b);
        writeLedIfChanged(r, g, b);
    } else {
        ledActive = false;
        writeLedIfChanged(0, 0, 0);
    }
}

// A stable-edge debouncer shared by FN, UP and DOWN. Only an actual stable
// HIGH -> LOW transition produces pressed. A key held during boot must first
// be released stably before its first command is accepted.
struct DebouncedControlButton {
    bool rawPressed = false;
    bool pressed = false;
    bool armed = true;
    unsigned long lastRawChangeMs = 0;

    void init(bool initialPressed, unsigned long now) {
        rawPressed = pressed = initialPressed;
        armed = !initialPressed;
        lastRawChangeMs = now;
    }
    // bit 0=confirmed press, bit 1=confirmed release
    uint8_t update(bool readingPressed, unsigned long now) {
        if (readingPressed != rawPressed) {
            rawPressed = readingPressed;
            lastRawChangeMs = now;
        }
        if (rawPressed == pressed ||
            (unsigned long)(now - lastRawChangeMs) < CONTROL_DEBOUNCE_MS) return 0;
        pressed = rawPressed;
        if (!pressed) {
            const bool wasArmed = armed;
            armed = true;
            return wasArmed ? 2u : 0u; // ignore release of a key held during boot
        }
        return armed ? 1u : 0u;
    }
};

// Called only after EngineTask grants an idle flash window. Keep failed writes
// pending, show a visible warning, and retry later without writing on every loop.
bool saveConfigSafely() {
    if (!settingsStoreReady) settingsStoreReady = prefs.begin("recoil_cfg", false);
    if (!settingsStoreReady) { settingsSaveFailed = true; return false; }
    const ControlSnapshot saved = readControl();
    if (needSaveProfile) {
        const int profile = constrain(saved.profile, 0, 14);
        if (prefs.getInt("prof_idx", -1) == profile ||
            prefs.putInt("prof_idx", profile) == sizeof(int32_t)) needSaveProfile = false;
    }
    if (needSaveMode) {
        const int mode = saved.mode;
        if (prefs.getInt("mode_idx", -1) == mode ||
            prefs.putInt("mode_idx", mode) == sizeof(int32_t)) needSaveMode = false;
    }
    settingsSaveFailed = needSaveProfile || needSaveMode;
    return !settingsSaveFailed;
}

// ================= МОНОПОЛЬНАЯ ЗАДАЧА ДВИЖКА НА CORE 1 =================
void EngineTask(void *pvParameters) {
    // A failed ControlTask creation must never leave a live HID engine running.
    while (!g_tasksReady.load(std::memory_order_acquire)) {
        vTaskDelay(pdMS_TO_TICKS(1));
    }
    int cachedProfileIdx = 14;
    CombatMode activeMode = MODE_CLOSE; // режим зафиксирован на текущее удержание
    bool cachedEnabled = true;
    uint8_t syncCounter = 0;

    bool rawLastReading = false;
    bool debouncedTrigger = false;
    uint64_t lastDebounceChangeUs = esp_timer_get_time();

    bool buttonPhysicallyHeld = false;
    // На старте уже замкнутый GPIO5 не должен запускать движение.
    bool requireStartupRelease =
        (gpio_get_level((gpio_num_t)TRIGGER_PIN) == 0);
    bool isRecoilActive = false;
    bool inSustainLoop = false;
    bool startedFromColdBarrel = true;
    bool shootLedSignaled = false;
    uint64_t pressStartTimeUs = 0;
    uint64_t lastReleaseTimeUs = 0;

    // Cooldown: отдельный снимок на отпускании, не затираемый при сбросе currentShot.
    bool warmStateValid = false;
    int savedShotOnRelease = 0;
    bool savedSustainOnRelease = false;
    CombatMode savedModeOnRelease = MODE_CLOSE;

    int activePatternIndex = 0;
    int lastColdPatternIndex = -1;
    float targetMirrorX = 1.0f;
    float smoothMirrorX = 1.0f;
    int currentShot = 0;
    R32CachedSpline splineCache;

    uint64_t shotStartTimeUs = 0;
    uint64_t lastTickTimeUs = esp_timer_get_time();
    uint64_t nextWakeTimeUs = lastTickTimeUs + BASE_TICK_US;
    uint64_t currentShotIntervalUs = BASE_SHOT_INTERVAL_US;

    // rem_* = неотправленный остаток с субпиксельной точностью.
    float rem_x = 0.0f;
    float rem_y = 0.0f;
    float smooth_x = 0.0f;
    float smooth_y = 0.0f;
    float drift_x = 0.0f;
    float drift_y = 0.0f;
    recoil::HidBacklogGuard hidBacklog(HID_BUSY_DROP_US);
    #if (ENGINE_DIAGNOSTICS == 1)
    uint32_t consecutiveHidBusyTicks = 0;
    #endif

    // Только успешно поставленные в очередь отчеты учитываются для Spring-Back.
    int32_t sentDuringPressX = 0;
    int32_t sentDuringPressY = 0;
    struct SpringBackState {
        bool active = false;
        uint64_t startUs = 0;
        int32_t totalX = 0, totalY = 0;
        int32_t queuedX = 0, queuedY = 0;
    } spring;

    // Долг первой пули: реально потерянное из-за tap-огибающей интегральное
    // движение, а не приближение из предположения о постоянном значении сплайна.
    float catchupDebtX = 0.0f;
    float catchupDebtY = 0.0f;
    float catchupProgress = 0.0f;
    float catchupCarryX = 0.0f;
    float catchupCarryY = 0.0f;

    #if (ENGINE_TASK_WDT == 1)
    // Подписываем именно EngineTask. Если TWDT не инициализирован в SDK,
    // add() вернёт ошибку; не пытаемся менять глобальную конфигурацию WDT.
    const bool engineWdtRegistered = (esp_task_wdt_add(NULL) == ESP_OK);
    #elif (ENGINE_DIAGNOSTICS == 1)
    const bool engineWdtRegistered = false;
    #endif

    #if (ENGINE_DIAGNOSTICS == 1)
    uint64_t diagWindowStartUs = lastTickTimeUs;
    uint32_t diagTicks = 0, diagMinDt = UINT32_MAX, diagMaxDt = 0;
    uint32_t diagLate = 0, diagMaxLateUs = 0;
    uint32_t diagHidQueued = 0, diagHidBusy = 0, diagHidRejected = 0;
    uint32_t diagDrops = 0, diagWarmStarts = 0, diagSpringStarts = 0;
    uint32_t diagUnmounted = 0, diagMaxBusyStreak = 0;
    uint32_t diagMaxPendingAgeUs = 0, diagMaxPendingAbs = 0;
    uint32_t diagMissedSlots = 0, diagReadyAfterBusy = 0, diagMaxQueueGapUs = 0;
    uint64_t lastQueuedReportUs = 0;
    g_engineDiag.watchdogActive.store(engineWdtRegistered ? 1 : 0, std::memory_order_relaxed);
    #endif

    #if (ENGINE_DIAGNOSTICS == 1)
    // All peak calculations happen in Core 1's local counters.
    auto trackPending = [&](uint64_t now, float x, float y) {
        const float f = fmaxf(fabsf(x), fabsf(y));
        const uint32_t pendingAbs = (f > (float)UINT32_MAX) ? UINT32_MAX : (uint32_t)f;
        if (pendingAbs > diagMaxPendingAbs) diagMaxPendingAbs = pendingAbs;
        if (hidBacklog.blockedSinceUs > 0) {
            const uint64_t age = now - hidBacklog.blockedSinceUs;
            const uint32_t ageUs = (age > UINT32_MAX) ? UINT32_MAX : (uint32_t)age;
            if (ageUs > diagMaxPendingAgeUs) diagMaxPendingAgeUs = ageUs;
        }
    };
    #endif

    #if (ENGINE_TASK_WDT == 1)
    uint8_t wdtTickCounter = 0;
    #endif
    for (;;) {
        uint64_t nowUs = esp_timer_get_time();
        waitForEngineDeadline(nextWakeTimeUs);

        nowUs = esp_timer_get_time();
        #if (ENGINE_DIAGNOSTICS == 1)
        const uint64_t lateUs = (nowUs > nextWakeTimeUs) ?
            (nowUs - nextWakeTimeUs) : 0ULL;
        if (lateUs >= ENGINE_LATE_THRESHOLD_US) ++diagLate;
        if (lateUs > diagMaxLateUs)
            diagMaxLateUs = (lateUs > UINT32_MAX) ? UINT32_MAX : (uint32_t)lateUs;
        #endif
#if R32_ABSOLUTE_SCHEDULER
        // Deadlines are anchored to their own timeline; the timer releases Core 1.
        // A late tick cannot push every future tick late. Skip elapsed deadlines;
        // NEVER burst HID reports to "replay" missed polls.
        nextWakeTimeUs += generateNextTickDurationUs();
        uint32_t skipped = 0;
        while (nextWakeTimeUs <= nowUs && skipped < 16) {
            nextWakeTimeUs += generateNextTickDurationUs();
            ++skipped;
        }
        if (nextWakeTimeUs <= nowUs) {
            nextWakeTimeUs = nowUs + generateNextTickDurationUs();
            ++skipped; // long pause: resynchronize rather than spin endlessly
        }
#if ENGINE_DIAGNOSTICS
        diagMissedSlots += skipped;
#endif
#else
        nextWakeTimeUs = nowUs + generateNextTickDurationUs();
#endif

        uint64_t dtUs = nowUs - lastTickTimeUs;
        lastTickTimeUs = nowUs;
        #if (ENGINE_DIAGNOSTICS == 1)
        ++diagTicks;
        const uint32_t rawDt = (dtUs > UINT32_MAX) ? UINT32_MAX : (uint32_t)dtUs;
        if (rawDt < diagMinDt) diagMinDt = rawDt;
        if (rawDt > diagMaxDt) diagMaxDt = rawDt;
        // Публикация только на границе секундного окна, без Serial/USB на Core 1.
        if (nowUs - diagWindowStartUs >= 1000000ULL) {
            g_r32DiagSequence.fetch_add(1u, std::memory_order_acq_rel); // odd: writer active
            g_engineDiag.ticks.store(diagTicks, std::memory_order_relaxed);
            g_engineDiag.minDtUs.store(diagTicks ? diagMinDt : 0u, std::memory_order_relaxed);
            g_engineDiag.maxDtUs.store(diagMaxDt, std::memory_order_relaxed);
            g_engineDiag.lateTicks.store(diagLate, std::memory_order_relaxed);
            g_engineDiag.maxLatenessUs.store(diagMaxLateUs, std::memory_order_relaxed);
            g_engineDiag.hidQueued.store(diagHidQueued, std::memory_order_relaxed);
            g_engineDiag.hidBusy.store(diagHidBusy, std::memory_order_relaxed);
            g_engineDiag.hidRejected.store(diagHidRejected, std::memory_order_relaxed);
            g_engineDiag.hidDrops.store(diagDrops, std::memory_order_relaxed);
            g_engineDiag.hidUnmountedTicks.store(diagUnmounted, std::memory_order_relaxed);
            g_engineDiag.hidMaxBusyStreak.store(diagMaxBusyStreak, std::memory_order_relaxed);
            g_engineDiag.hidMaxPendingAgeUs.store(diagMaxPendingAgeUs, std::memory_order_relaxed);
            g_engineDiag.hidMaxPendingAbs.store(diagMaxPendingAbs, std::memory_order_relaxed);
            g_engineDiag.schedulerMissedSlots.store(diagMissedSlots, std::memory_order_relaxed);
            g_engineDiag.hidReadyAfterBusy.store(diagReadyAfterBusy, std::memory_order_relaxed);
            g_engineDiag.hidMaxQueuedAgeUs.store(diagMaxQueueGapUs, std::memory_order_relaxed);
            g_engineDiag.warmStarts.store(diagWarmStarts, std::memory_order_relaxed);
            g_engineDiag.springStarts.store(diagSpringStarts, std::memory_order_relaxed);
            std::atomic_thread_fence(std::memory_order_release);
            g_r32DiagSequence.fetch_add(1u, std::memory_order_release); // even: complete
            diagTicks=0; diagMinDt=UINT32_MAX; diagMaxDt=0;
            diagLate=0; diagMaxLateUs=0;
            diagHidQueued=0; diagHidBusy=0; diagHidRejected=0;
            diagDrops=0; diagWarmStarts=0; diagSpringStarts=0;
            diagUnmounted=0; diagMaxBusyStreak=0;
            diagMaxPendingAgeUs=0; diagMaxPendingAbs=0;
            diagMissedSlots=0; diagReadyAfterBusy=0; diagMaxQueueGapUs=0;
            diagWindowStartUs = nowUs;
        }
        #endif
        #if (ENGINE_TASK_WDT == 1)
        if (engineWdtRegistered && (++wdtTickCounter & 0x7F) == 0) {
            esp_task_wdt_reset();
        }
        #endif
        // Длинный пропуск НЕ превращаем искусственно в ровно 1 мс.
        // Ограничение 5 мс защищает от большого одноразового скачка курсора.
        const bool longTimingPause = dtUs >= HID_BUSY_DROP_US;
        if (dtUs == 0ULL) dtUs = BASE_TICK_US;
        if (dtUs > 5000ULL) dtUs = 5000ULL;
        const R32TimeDynamics timeDynamics = r32TimeDynamics((uint32_t)dtUs);

        // OFF/ON every engine tick (no 16-tick safety latency).
        // PROFILE still refreshes every 16 ticks to preserve the R2 live scaling.
        const ControlSnapshot liveCfg = readControl();
        cachedEnabled = liveCfg.enabled;
        if ((++syncCounter & 0x0F) == 0) {
            cachedProfileIdx = fastClampI(liveCfg.profile, 0, 14);
        }

        // Исходный симметричный 3-мс антидребезг оставлен без изменений.
        const bool rawPressed = (gpio_get_level((gpio_num_t)TRIGGER_PIN) == 0);
        if (rawPressed != rawLastReading) {
            rawLastReading = rawPressed;
            lastDebounceChangeUs = nowUs;
        }
        if ((nowUs - lastDebounceChangeUs) >= DEBOUNCE_TRIGGER_US) {
            debouncedTrigger = rawPressed;
        }
        // Защита снимается только после СТАБИЛЬНОГО отпущенного контакта,
        // иначе 1-мс отскок мог бы разрешить запуск при удержании во время boot.
        if (requireStartupRelease && !rawPressed && !debouncedTrigger &&
            (nowUs - lastDebounceChangeUs >= DEBOUNCE_TRIGGER_US)) {
            requireStartupRelease = false;
        }

        if (longTimingPause) {
            // No old filter tail, debt, or return may survive a stalled engine.
            spring.active = false;
            rem_x = rem_y = smooth_x = smooth_y = 0.0f;
            catchupDebtX = catchupDebtY = catchupCarryX = catchupCarryY = 0.0f;
            hidBacklog.reset();
        }

        // Core 0 requests NVS work; Core 1 acknowledges only when all motion,
        // including spring-back, has stopped. No engine work runs during the write.
        if (g_flashSaveRequested.load(std::memory_order_acquire) &&
            !isRecoilActive && !spring.active && !rawPressed && !debouncedTrigger) {
            g_flashSaveGranted.store(true, std::memory_order_release);
            while (g_flashSaveRequested.load(std::memory_order_acquire)) {
#if ENGINE_TASK_WDT
                if (engineWdtRegistered) esp_task_wdt_reset();
#endif
                vTaskDelay(1);
            }
            g_flashSaveGranted.store(false, std::memory_order_release);
            nowUs = esp_timer_get_time();
            lastTickTimeUs = nowUs;
            nextWakeTimeUs = nowUs + BASE_TICK_US;
            rawLastReading = gpio_get_level((gpio_num_t)TRIGGER_PIN) == 0;
            debouncedTrigger = rawLastReading;
            buttonPhysicallyHeld = false;
            requireStartupRelease = rawLastReading;
            lastDebounceChangeUs = nowUs;
            continue;
        }

        // Never resume a held trigger after USB unplug/suspend/reconnect. Also
        // discard all filter/debt state so no old movement survives transport loss.
        if (!Mouse16.mounted() || tud_suspended()) {
#if ENGINE_DIAGNOSTICS
            ++diagUnmounted;
            consecutiveHidBusyTicks = 0;
#endif
            requireStartupRelease = true;
            buttonPhysicallyHeld = false;
            isRecoilActive = spring.active = warmStateValid = false;
            inSustainLoop = shootLedSignaled = false;
            rem_x = rem_y = smooth_x = smooth_y = 0.0f;
            catchupDebtX = catchupDebtY = catchupCarryX = catchupCarryY = 0.0f;
            hidBacklog.reset();
            g_engineLedState.store(ENGINE_LED_IDLE, std::memory_order_relaxed);
            continue;
        }

        if (debouncedTrigger && !buttonPhysicallyHeld && !requireStartupRelease) {
            buttonPhysicallyHeld = true;
            pressStartTimeUs = nowUs;
            // При новом нажатии не продолжать предыдущий возврат поверх новой очереди.
            spring.active = false;

            const ControlSnapshot cfg = readControl();
            cachedProfileIdx = fastClampI(cfg.profile, 0, 14);
            activeMode = cfg.mode; // выбранный режим фиксируется на весь press/release
            cachedEnabled = cfg.enabled;

            if (cachedEnabled) {
                isRecoilActive = true;
                shootLedSignaled = false;

                // Warm start: восстановить сохраненную позицию той же траектории.
                const uint64_t idleMs = (lastReleaseTimeUs > 0)
                    ? ((nowUs - lastReleaseTimeUs) / 1000ULL) : SPRAY_COOLDOWN_MS;
                const bool canResume = warmStateValid &&
                    (activeMode == savedModeOnRelease) && (idleMs < SPRAY_COOLDOWN_MS);
                if (canResume) {
                    #if (ENGINE_DIAGNOSTICS == 1)
                    ++diagWarmStarts;
                    #endif
                    const int stepsBack = (int)(idleMs / COOLDOWN_STEP_MS);
                    currentShot = fastClampI(savedShotOnRelease - stepsBack, 0, SHOTS_PER_SPRAY - 1);
                    inSustainLoop = savedSustainOnRelease && (currentShot >= LOOP_START_SHOT);
                } else {
                    currentShot = 0;
                    inSustainLoop = false;
                    activePatternIndex = r32ChooseColdPattern(lastColdPatternIndex);
                    lastColdPatternIndex = activePatternIndex;
                    targetMirrorX = (recoilRandomBits() & 1) ? 1.0f : -1.0f;
                    smoothMirrorX = targetMirrorX;
                }
                startedFromColdBarrel = (currentShot == 0);
                shotStartTimeUs = nowUs;
                currentShotIntervalUs = generateNextIntervalUs();

                rem_x = rem_y = 0.0f;
                smooth_x = smooth_y = 0.0f;
                drift_x = drift_y = 0.0f;
                hidBacklog.reset();
                #if (ENGINE_DIAGNOSTICS == 1)
                consecutiveHidBusyTicks = 0;
                #endif
                sentDuringPressX = sentDuringPressY = 0;
                catchupDebtX = catchupDebtY = 0.0f;
                catchupProgress = 0.0f;
                catchupCarryX = catchupCarryY = 0.0f;
            } else {
                warmStateValid = false;
            }
        } else if (!debouncedTrigger && buttonPhysicallyHeld) {
            buttonPhysicallyHeld = false;
            lastReleaseTimeUs = nowUs;

            if (isRecoilActive) {
                // Снимок до сброса: иначе всегда восстановится только 0-й сегмент.
                savedShotOnRelease = currentShot;
                savedSustainOnRelease = inSustainLoop;
                savedModeOnRelease = activeMode;
                warmStateValid = true;
                isRecoilActive = false;
                inSustainLoop = false;
                currentShot = 0;

                #if (TAP_SPRINGBACK_ENABLE == 1)
                if ((nowUs - pressStartTimeUs) < TAP_WINDOW_US &&
                    (sentDuringPressX != 0 || sentDuringPressY != 0) &&
                    (SPRINGBACK_ON_WARM_TAP || startedFromColdBarrel)) {
                    #if (ENGINE_DIAGNOSTICS == 1)
                    ++diagSpringStarts;
                    #endif
                    spring.active = true;
                    spring.startUs = nowUs;
                    spring.totalX = -sentDuringPressX;
                    spring.totalY = -sentDuringPressY;
                    spring.queuedX = spring.queuedY = 0;
                }
                #endif

                // Неотправленные движения из завершенной очереди недопустимо
                // проталкивать позже: USB-девайс мог быть отключен/занят.
                rem_x = rem_y = 0.0f;
                g_engineLedState.store(ENGINE_LED_IDLE, std::memory_order_relaxed);
                shootLedSignaled = false;
            }
        }

        if (!cachedEnabled) {
            warmStateValid = false;
            if (isRecoilActive || spring.active) {
                isRecoilActive = false;
                spring.active = false;
                inSustainLoop = false;
                warmStateValid = false;
                shootLedSignaled = false;
                rem_x = rem_y = 0.0f;
                g_engineLedState.store(ENGINE_LED_IDLE, std::memory_order_relaxed);
            }
            continue;
        }

        // Независимое состояние Spring-Back: отправляет инкременты ПОСЛЕ release.
        if (!isRecoilActive && spring.active) {
            if (!Mouse16.mounted()) {
                spring.active = false; // Отключен USB — не копим возврат до переподключения.
            } else if (recoil::springExpired(nowUs - spring.startUs,
                                            TAP_SPRINGBACK_TIME_US, HID_BUSY_DROP_US)) {
                spring.active = false; // check deadline BEFORE attempting any report
            } else {
                const uint64_t passed = nowUs - spring.startUs;
                const float u = (float)passed / (float)TAP_SPRINGBACK_TIME_US;
                const float fraction = easeCubic(u);
                const int desiredX = (int)__builtin_lrintf((float)spring.totalX * fraction);
                const int desiredY = (int)__builtin_lrintf((float)spring.totalY * fraction);
                const int stepX = desiredX - spring.queuedX;
                const int stepY = desiredY - spring.queuedY;
                if (stepX != 0 || stepY != 0) {
                    const int16_t dx = (int16_t)fastClampI(stepX, -32767, 32767);
                    const int16_t dy = (int16_t)fastClampI(stepY, -32767, 32767);
                    if (!Mouse16.ready()) {
                        #if (ENGINE_DIAGNOSTICS == 1)
                        ++diagHidBusy;
                        #endif
                    } else if (Mouse16.sendMove(dx, dy)) {
                        spring.queuedX += dx;
                        spring.queuedY += dy;
                        #if (ENGINE_DIAGNOSTICS == 1)
                        ++diagHidQueued;
                        #endif
                    } else {
                        #if (ENGINE_DIAGNOSTICS == 1)
                        ++diagHidRejected;
                        #endif
                    }
                }
                if ((passed >= TAP_SPRINGBACK_TIME_US &&
                     spring.queuedX == spring.totalX && spring.queuedY == spring.totalY) ||
                    recoil::springExpired(passed, TAP_SPRINGBACK_TIME_US, HID_BUSY_DROP_US)) {
                    spring.active = false;
                }
            }
        }

        if (!isRecoilActive) continue;

        // Абсолютное продвижение фазы: опоздание тика не суммируется со временем
        // следующего сегмента. Учитываем также пропуск нескольких границ.
        int crossed = 0;
        while ((nowUs - shotStartTimeUs) >= currentShotIntervalUs && crossed++ < 64) {
            // Хвост от дискретизации плавного catch-up отдаем первым тиком нового сегмента.
            if (startedFromColdBarrel && currentShot == 0) {
                #if (TAP_AUTO_CATCHUP == 1)
                catchupCarryX += catchupDebtX * (1.0f - catchupProgress);
                catchupCarryY += catchupDebtY * (1.0f - catchupProgress);
                #endif
            }
            shotStartTimeUs += currentShotIntervalUs;
            currentShotIntervalUs = generateNextIntervalUs();
            ++currentShot;
            if (currentShot >= SHOTS_PER_SPRAY) {
                currentShot = LOOP_START_SHOT;
                inSustainLoop = true;
                if (recoilRandomBits() & 1) targetMirrorX = -targetMirrorX;
            }
        }
        if (crossed >= 64) {
            // Не пытаться отыграть огромный пропуск после зависания/остановки таймера.
            shotStartTimeUs = nowUs;
            currentShotIntervalUs = generateNextIntervalUs();
            catchupCarryX = catchupCarryY = 0.0f;
        }

        smoothMirrorX += timeDynamics.mirrorAlpha * (targetMirrorX - smoothMirrorX);

        const int safePattern = fastClampI(activePatternIndex, 0, NUM_PATTERNS - 1);
        const int idx1 = currentShot;
        const BulletTarget (*bank)[SHOTS_PER_SPRAY] =
            (activeMode == MODE_CLOSE) ? PATTERN_CLOSE : PATTERN_LONG;
        const float coreAnchorY =
            (activeMode == MODE_CLOSE) ? CORE_ANCHOR_CLOSE_Y : CORE_ANCHOR_LONG_Y;
        const float invInterval = 1.0f / (float)currentShotIntervalUs;
        const float t = (float)(nowUs - shotStartTimeUs) * invInterval;
        BulletTarget splineVec;
#if R32_SPLINE_CACHE
        r32PrepareSpline(splineCache, currentShot, safePattern, activeMode, inSustainLoop, bank, coreAnchorY);
        splineVec = r32EvalSpline(splineCache, t);
#else
        const BulletTarget p0 = getBalancedNode(bank, safePattern, r32NeighborIndex(currentShot,-1,inSustainLoop), coreAnchorY);
        const BulletTarget p1 = getBalancedNode(bank, safePattern, r32NeighborIndex(currentShot, 0,inSustainLoop), coreAnchorY);
        const BulletTarget p2 = getBalancedNode(bank, safePattern, r32NeighborIndex(currentShot,+1,inSustainLoop), coreAnchorY);
        const BulletTarget p3 = getBalancedNode(bank, safePattern, r32NeighborIndex(currentShot,+2,inSustainLoop), coreAnchorY);
        splineVec = evalCatmullRom(p0, p1, p2, p3, t);
#endif

        const float currentMultY = MULTIPLIERS[cachedProfileIdx];
        const float currentMultX = (activeMode == MODE_CLOSE)
            ? (currentMultY * 0.70f) : (currentMultY * 0.20f);
        const float dtWeight = (float)dtUs * invInterval;

        // Исходная кубическая огибающая тапа (точно как в Gemini).
        const uint64_t holdTimeUs = nowUs - pressStartTimeUs;
        float tapEnvelope = 1.0f;
        if (startedFromColdBarrel && currentShot == 0 && holdTimeUs < TAP_WINDOW_US) {
            const float u = (float)holdTimeUs / (float)TAP_WINDOW_US;
            if (TAP_CURVE_POWER == 2) tapEnvelope = u * u;
            else if (TAP_CURVE_POWER == 3) tapEnvelope = u * u * u;
            else { const float u2 = u * u; tapEnvelope = u2 * u2; }
        }

        const float baseX = (splineVec.x * smoothMirrorX) * dtWeight * BASE_PIXEL_SCALE_X * currentMultX;
        const float baseY = splineVec.y * dtWeight * BASE_PIXEL_SCALE_Y * currentMultY;
        float spline_x = baseX * tapEnvelope;
        float spline_y = baseY * tapEnvelope;

        #if (TAP_AUTO_CATCHUP == 1)
        if (startedFromColdBarrel && currentShot == 0) {
            if (holdTimeUs < TAP_WINDOW_US) {
                catchupDebtX += baseX - spline_x;
                catchupDebtY += baseY - spline_y;
            } else {
                // Долг от первой половины распределяется кубической плавной функцией.
                // Начало и конец добавки: нулевая скорость (нет ступеньки 1.0 -> 1.75).
                const float repaymentUs = (float)(currentShotIntervalUs - TAP_WINDOW_US);
                const float progress = easeCubic(((float)holdTimeUs - (float)TAP_WINDOW_US) / repaymentUs);
                const float stepProgress = fastClampF(progress - catchupProgress, 0.0f, 1.0f);
                spline_x += catchupDebtX * stepProgress;
                spline_y += catchupDebtY * stepProgress;
                catchupProgress = progress;
            }
        }
        spline_x += catchupCarryX;
        spline_y += catchupCarryY;
        catchupCarryX = catchupCarryY = 0.0f;
        #endif

        if (!shootLedSignaled &&
            (!startedFromColdBarrel || holdTimeUs >= TAP_WINDOW_US)) {
            shootLedSignaled = true;
            g_engineLedState.store((activeMode == MODE_CLOSE) ? ENGINE_LED_CLOSE : ENGINE_LED_LONG,
                                   std::memory_order_relaxed);
        }

        // Noise/fatigue parameters are preserved; variable-dt smoothing is
        // displacement-conserving and matches the original EMA at nominal dt.
        const float jitterActive = (currentMultY > 0.001f) ? tapEnvelope : 0.0f;
        const float fatigueFactor = computeMuscleFatigueFactor(idx1, t, inSustainLoop);
        const float dynamicMicroAmp = JITTER_MICRO_AMP_PX * fatigueFactor;
        // Variable-dt Ornstein-Uhlenbeck scaling: same stationary variance as R3.1
        // and the same coefficients at exactly 1000us. Random draw count unchanged.
        drift_x = timeDynamics.driftRho * drift_x +
                  timeDynamics.driftInnovation * randomCenteredFloat() * JITTER_DRIFT_AMP_PX;
        drift_y = timeDynamics.driftRho * drift_y +
                  timeDynamics.driftInnovation * randomCenteredFloat() * JITTER_DRIFT_AMP_PX;
        const float micro_x = randomCenteredFloat() * dynamicMicroAmp * timeDynamics.microScale;
        const float micro_y = randomCenteredFloat() * dynamicMicroAmp * timeDynamics.microScale;

        if (currentMultY <= 0.001f) {
            // Zero profile means zero new motion, including an old EMA/backlog tail.
            rem_x = rem_y = smooth_x = smooth_y = 0.0f;
            catchupDebtX = catchupDebtY = catchupCarryX = catchupCarryY = 0.0f;
            hidBacklog.reset();
            continue;
        }
        const float raw_x = spline_x + (drift_x + micro_x) * jitterActive;
        const float raw_y = spline_y + (drift_y + micro_y) * jitterActive;
        const float dtInTicks = (float)dtUs / (float)BASE_TICK_US;
        const float increment_x = recoil::filterIncrement(raw_x, dtInTicks,
            timeDynamics.emaAlpha, EMA_SMOOTH_ALPHA, smooth_x);
        const float increment_y = recoil::filterIncrement(raw_y, dtInTicks,
            timeDynamics.emaAlpha, EMA_SMOOTH_ALPHA, smooth_y);

        // Субпиксельная арифметика: при сбое очереди HID сохраняем необслуженный
        // инкремент. При долгой занятости >25 мс сбрасываем его, чтобы не было рывка.
        rem_x += increment_x;
        rem_y += increment_y;
        if (!Mouse16.mounted()) {
            // Только полное отключение USB стирает старый долг немедленно.
            rem_x = rem_y = 0.0f;
            hidBacklog.reset();
            #if (ENGINE_DIAGNOSTICS == 1)
            consecutiveHidBusyTicks = 0;
            ++diagUnmounted;
            #endif
            continue;
        }
        if (!Mouse16.ready()) {
            #if (ENGINE_DIAGNOSTICS == 1)
            ++diagHidBusy;
            if (++consecutiveHidBusyTicks > diagMaxBusyStreak)
                diagMaxBusyStreak = consecutiveHidBusyTicks;
            #endif
            // Endpoint занят штатным предыдущим пакетом — сохранить остаток до
            // следующего тика, не превращая это в потерянное движение.
            const bool backlogExpired = hidBacklog.onBlocked(nowUs);
            #if (ENGINE_DIAGNOSTICS == 1)
            trackPending(nowUs, rem_x, rem_y);
            #endif
            if (backlogExpired) {
                rem_x = rem_y = smooth_x = smooth_y = 0.0f;
                catchupDebtX = catchupDebtY = catchupCarryX = catchupCarryY = 0.0f;
                #if (ENGINE_DIAGNOSTICS == 1)
                ++diagDrops;
                #endif
            }
            continue;
        }
        #if (ENGINE_DIAGNOSTICS == 1)
        if (consecutiveHidBusyTicks > 0) ++diagReadyAfterBusy; // proxy, not USB completion!
        consecutiveHidBusyTicks = 0;
        #endif
        // Ready may have returned only after a long scheduling/USB pause.
        // Reject stale history even on the ready path, before rounding or sending.
        if (hidBacklog.expired(nowUs)) {
            rem_x = rem_y = smooth_x = smooth_y = 0.0f;
            catchupDebtX = catchupDebtY = catchupCarryX = catchupCarryY = 0.0f;
            // Ready is only a hint; a zero-motion probe must actually enter
            // the queue before a stale/rejected transport is considered recovered.
            // A failed probe leaves the stale state latched, never re-accumulating.
            if (Mouse16.sendMove(0, 0)) {
                hidBacklog.reset();
#if ENGINE_DIAGNOSTICS
                ++diagHidQueued;
#endif
            } else {
                (void)hidBacklog.onBlocked(nowUs);
#if ENGINE_DIAGNOSTICS
                ++diagHidRejected;
#endif
            }
#if ENGINE_DIAGNOSTICS
            ++diagDrops;
#endif
            continue;
        }
        const int send_x = (int)__builtin_lrintf(rem_x);
        const int send_y = (int)__builtin_lrintf(rem_y);
        if (send_x != 0 || send_y != 0) {
            const int16_t out_x = (int16_t)fastClampI(send_x, -32767, 32767);
            const int16_t out_y = (int16_t)fastClampI(send_y, -32767, 32767);
            if (Mouse16.sendMove(out_x, out_y)) {
                #if (ENGINE_DIAGNOSTICS == 1)
                ++diagHidQueued;
                if (lastQueuedReportUs > 0) {
                    const uint64_t since = nowUs - lastQueuedReportUs;
                    if (since > diagMaxQueueGapUs)
                        diagMaxQueueGapUs = since > UINT32_MAX ? UINT32_MAX : (uint32_t)since;
                }
                lastQueuedReportUs = nowUs;
                #endif
                rem_x -= (float)out_x;
                rem_y -= (float)out_y;
                // Only a tap can request a return. Bound counters even if the
                // trigger remains held for days (avoid signed integer overflow).
                if (nowUs - pressStartTimeUs < TAP_WINDOW_US) {
                    sentDuringPressX += out_x;
                    sentDuringPressY += out_y;
                }
                hidBacklog.reset();
            } else {
                #if (ENGINE_DIAGNOSTICS == 1)
                ++diagHidRejected;
                #endif
                const bool backlogExpired = hidBacklog.onBlocked(nowUs);
                #if (ENGINE_DIAGNOSTICS == 1)
                trackPending(nowUs, rem_x, rem_y);
                #endif
                if (backlogExpired) {
                    rem_x = rem_y = smooth_x = smooth_y = 0.0f;
                    catchupDebtX = catchupDebtY = catchupCarryX = catchupCarryY = 0.0f;
                    #if (ENGINE_DIAGNOSTICS == 1)
                    ++diagDrops;
                    #endif
                }
            }
        }
    }
}

// ================= ЗАДАЧА ПЕРИФЕРИИ, КНОПОК И NVS НА CORE 0 =================
void ControlTask(void *pvParameters) {
    DebouncedControlButton fn, up, down;
    unsigned long now = millis();
    fn.init(digitalRead(FN_BUTTON_PIN) == LOW, now);
    up.init(digitalRead(BTN_PROF_UP_PIN) == LOW, now);
    down.init(digitalRead(BTN_PROF_DOWN_PIN) == LOW, now);

    recoil::FnGesture fnGesture(FN_HOLD_MS, FN_MIN_CLICK_MS, FN_DOUBLE_WINDOW_MS);

    for (;;) {
        now = millis();
        updateBlinker(now);
        const uint8_t fnEdge = fn.update(digitalRead(FN_BUTTON_PIN) == LOW, now);
        const auto event = fnGesture.update(fnEdge & 1u, fnEdge & 2u, fn.pressed, now);
        if (event == recoil::FnGesture::LONG_HOLD) {
            const CombatMode newMode = (readControl().mode == MODE_CLOSE) ? MODE_LONG : MODE_CLOSE;
            setControlMode(newMode);
            needSaveMode = true;
            saveSettingsTime = now + 2000UL;
            if (newMode == MODE_CLOSE) startBlink(0, 20, 80, 3);
            else startBlink(80, 0, 80, 3);
        } else if (event == recoil::FnGesture::DOUBLE_CLICK) {
            const bool enabled = !readControl().enabled;
            setControlEnabled(enabled);
            if (enabled) startBlink(0, 60, 0, 2);
            else startBlink(60, 0, 0, 2);
        }

        const uint8_t upEdge = up.update(digitalRead(BTN_PROF_UP_PIN) == LOW, now);
        if (upEdge & 1u) {
            const int next = constrain(readControl().profile + 1, 0, 14);
            if (next != readControl().profile) {
                setControlProfile(next);
                needSaveProfile = true;
                saveSettingsTime = now + 2000UL;
            }
            setProfileColor(next);
        }
        const uint8_t downEdge = down.update(digitalRead(BTN_PROF_DOWN_PIN) == LOW, now);
        if (downEdge & 1u) {
            const int next = constrain(readControl().profile - 1, 0, 14);
            if (next != readControl().profile) {
                setControlProfile(next);
                needSaveProfile = true;
                saveSettingsTime = now + 2000UL;
            }
            setProfileColor(next);
        }

        const bool physicallyShooting = gpio_get_level((gpio_num_t)TRIGGER_PIN) == 0;
        if ((needSaveProfile || needSaveMode) &&
            (int32_t)(now - saveSettingsTime) >= 0 && !physicallyShooting &&
            !g_engineFault.load(std::memory_order_acquire)) {
            g_flashSaveRequested.store(true, std::memory_order_release);
        }
        if (g_flashSaveGranted.load(std::memory_order_acquire) &&
            g_flashSaveRequested.load(std::memory_order_acquire)) {
            saveConfigSafely();
            saveSettingsTime = millis() + 2000UL;
            g_flashSaveRequested.store(false, std::memory_order_release);
        }

        // Compute one authoritative LED color after updating all button states.
        renderLed(now);

        #if (ENGINE_DIAG_UART == 1)
        static unsigned long lastDiagPrintMs = 0;
        if ((unsigned long)(now - lastDiagPrintMs) >= 1000UL) {
            lastDiagPrintMs = now;
            R32DiagSnapshot diag;
            if (r32ReadDiagSnapshot(diag)) Serial0.printf("[engine] ticks=%lu dt=%lu..%lu us late=%lu maxlate=%lu us hidQ=%lu busy=%lu rejected=%lu drops=%lu unmounted=%lu busyPeak=%lu pendingAgeUs=%lu pendingAbs=%lu warm=%lu spring=%lu twdt=%lu missedSlots=%lu readyAfterBusy=%lu queueGapUs=%lu done=%lu failed=%lu\n",
                (unsigned long)diag.ticks,
                (unsigned long)diag.minDtUs,
                (unsigned long)diag.maxDtUs,
                (unsigned long)diag.lateTicks,
                (unsigned long)diag.maxLatenessUs,
                (unsigned long)diag.hidQueued,
                (unsigned long)diag.hidBusy,
                (unsigned long)diag.hidRejected,
                (unsigned long)diag.hidDrops,
                (unsigned long)diag.hidUnmountedTicks,
                (unsigned long)diag.hidMaxBusyStreak,
                (unsigned long)diag.hidMaxPendingAgeUs,
                (unsigned long)diag.hidMaxPendingAbs,
                (unsigned long)diag.warmStarts,
                (unsigned long)diag.springStarts,
                (unsigned long)diag.watchdogActive,
                (unsigned long)diag.schedulerMissedSlots,
                (unsigned long)diag.hidReadyAfterBusy,
                (unsigned long)diag.hidMaxQueuedAgeUs,
                (unsigned long)diag.hidTransferCompleted,
                (unsigned long)diag.hidTransferFailed);
        }
        #endif
        vTaskDelay(pdMS_TO_TICKS(10));
    }
}

[[noreturn]] void failStartup() {
    setControlEnabled(false);
    g_engineFault.store(true, std::memory_order_release);
    for (;;) {
        writeLedIfChanged(80, 0, 0); delay(150);
        writeLedIfChanged(0, 0, 0); delay(150);
    }
}

void setup() {
    #if (ENGINE_DIAG_UART == 1)
    Serial0.begin(115200);
    #endif
    pinMode(TRIGGER_PIN, INPUT_PULLUP);
    pinMode(FN_BUTTON_PIN, INPUT_PULLUP);
    pinMode(BTN_PROF_UP_PIN, INPUT_PULLUP);
    pinMode(BTN_PROF_DOWN_PIN, INPUT_PULLUP);

    writeLedIfChanged(20, 20, 20);

    // USB ID сохранен из исходника для совместимости; это не полная эмуляция G502.
    // Для своего устройства используйте законно выделенные VID/PID и собственные строки.
    USB.VID(0x046D);
    USB.PID(0xC08B);
    USB.usbVersion(0x0200);
    USB.usbPower(300);
    USB.usbAttributes(0xA0);
    USB.productName("G502 HERO Gaming Mouse");
    USB.manufacturerName("Logitech");
    USB.serialNumber("2543ZE1SMTL9");

    r32InitDynamics();
    Mouse16.begin();
    if (!USB.begin()) failStartup();

    settingsStoreReady = prefs.begin("recoil_cfg", false);
    settingsSaveFailed = !settingsStoreReady;
    int initProf = settingsStoreReady ? constrain(prefs.getInt("prof_idx", 14), 0, 14) : 14;

    int rawMode = settingsStoreReady ? prefs.getInt("mode_idx", MODE_CLOSE) : MODE_CLOSE;
    CombatMode initMode = (rawMode == MODE_LONG) ? MODE_LONG : MODE_CLOSE;

    // Одна атомарная публикация согласованной стартовой конфигурации.
    g_atomicState.packed.store(packControl(initProf, initMode, true), std::memory_order_relaxed);

    setProfileColor(initProf);

    // Timer-notification wait keeps Core 1 schedulable. Do not disable Idle WDT.
    esp_timer_create_args_t timerArgs = {};
    timerArgs.callback = engineWakeCallback;
    timerArgs.dispatch_method = ESP_TIMER_TASK;
    timerArgs.name = "engine-wake";
    if (esp_timer_create(&timerArgs, &engineWakeTimer) != ESP_OK) {
        failStartup();
    }

    // Create Engine first: it waits on g_tasksReady and cannot emit HID reports
    // until BOTH tasks were successfully created. Failure is visible on the LED.
    const BaseType_t engineCreated = xTaskCreatePinnedToCore(
        EngineTask, "EngineTask", 4096, NULL, 4, &engineTaskHandle, 1);
    BaseType_t controlCreated = pdFAIL;
    if (engineCreated == pdPASS && engineTaskHandle != NULL) {
        controlCreated = xTaskCreatePinnedToCore(
            ControlTask, "ControlTask", 4096, NULL, 1, &controlTaskHandle, 0);
    }
    if (engineCreated != pdPASS || engineTaskHandle == NULL ||
        controlCreated != pdPASS || controlTaskHandle == NULL) {
        // An error must not leave a working-looking HID engine with no buttons.
        failStartup();
    }
    g_tasksReady.store(true, std::memory_order_release);
}

void loop() {
    vTaskDelete(NULL);
}