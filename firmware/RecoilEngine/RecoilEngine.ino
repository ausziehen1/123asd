#pragma pack(push, 1)
struct MouseReport16 {
    uint8_t buttons;
    int16_t x;
    int16_t y;
    int8_t  wheel;
};
#pragma pack(pop)
static_assert(sizeof(MouseReport16) == 6, "HID report layout mismatch");

USBHID hid;

class CustomMouse16 : public USBHIDDevice {
public:
    CustomMouse16() {
        hid.addDevice(this, sizeof(report_descriptor));
    }

    void begin() {
        hid.begin();
    }

    uint16_t _onGetDescriptor(uint8_t* dst) override {
        memcpy(dst, report_descriptor, sizeof(report_descriptor));
        return sizeof(report_descriptor);
    }

    // Единственный отправитель HID — EngineTask. Передача не блокирует ядро ожиданием
    // завершения USB IN-пакета; true = отчет поставлен в TinyUSB, НЕ гарантия приема ОС.
    bool mounted() const {
        return tud_mounted();
    }
    bool ready() const {
        return tud_hid_n_ready(0);
    }
    bool sendMove(int16_t x, int16_t y) {
        if (!ready()) return false;
        MouseReport16 report = {0, x, y, 0};
        return tud_hid_n_report(0, REPORT_ID_MOUSE, &report, sizeof(report));
    }
};

CustomMouse16 Mouse16;

