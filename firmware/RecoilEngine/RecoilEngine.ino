    1.07f, 1.29f, 1.50f, 1.71f, 1.93f,
    2.14f, 2.36f, 2.57f, 2.79f, 3.00f
};

enum CombatMode : int {
    MODE_CLOSE = 0,
    MODE_LONG  = 1
};

// Один 32-битный атомарный снимок: нет смешивания старого MODE и нового PROFILE.
// Только Core 0 записывает настройки (в setup() до старта задач и затем в ControlTask).
// Core 1 читает целое слово одним load(std::memory_order_relaxed).
// Bits 0..3: profile 0..14; bit 4: mode; bit 5: enabled.
static constexpr uint32_t CFG_PROFILE_MASK = 0x0Fu;
static constexpr uint32_t CFG_MODE_MASK = 0x10u;
static constexpr uint32_t CFG_ENABLED_MASK = 0x20u;
static_assert(ATOMIC_INT_LOCK_FREE == 2, "ESP32-S3 requires lock-free 32-bit atomics");

struct ControlSnapshot {
    int profile;
    CombatMode mode;
    bool enabled;
};

static inline uint32_t packControl(int profile, CombatMode mode, bool enabled) {
    return (uint32_t)(profile & 0x0F) |
           ((mode == MODE_LONG) ? CFG_MODE_MASK : 0u) |
           (enabled ? CFG_ENABLED_MASK : 0u);
}

struct AtomicAppState {
    std::atomic<uint32_t> packed{14u | CFG_ENABLED_MASK};
};
DRAM_ATTR AtomicAppState g_atomicState;

static inline ControlSnapshot readControl() {
    const uint32_t word = g_atomicState.packed.load(std::memory_order_relaxed);
    return { (int)(word & CFG_PROFILE_MASK),
             ((word & CFG_MODE_MASK) != 0u) ? MODE_LONG : MODE_CLOSE,
             (word & CFG_ENABLED_MASK) != 0u };
}

// Управляющие операции только с Core 0: RMW не конкурирует с другими писателями.
static inline void setControlProfile(int profile) {
    const uint32_t old = g_atomicState.packed.load(std::memory_order_relaxed);
    const uint32_t next = (old & ~CFG_PROFILE_MASK) | (uint32_t)(profile & 0x0F);
    g_atomicState.packed.store(next, std::memory_order_relaxed);
}
static inline void setControlMode(CombatMode mode) {
    const uint32_t old = g_atomicState.packed.load(std::memory_order_relaxed);
    const uint32_t next = (old & ~CFG_MODE_MASK) |
                          ((mode == MODE_LONG) ? CFG_MODE_MASK : 0u);
    g_atomicState.packed.store(next, std::memory_order_relaxed);
}
static inline void setControlEnabled(bool enabled) {
    const uint32_t old = g_atomicState.packed.load(std::memory_order_relaxed);
    const uint32_t next = (old & ~CFG_ENABLED_MASK) | (enabled ? CFG_ENABLED_MASK : 0u);
    g_atomicState.packed.store(next, std::memory_order_relaxed);
}

// Диагностика публикуется одним словом на метрику раз в ~1 секунду.
// Все счётчики собираются локально Core 1 без атомарных RMW в горячем цикле.
struct EngineDiagnosticCounters {
    std::atomic<uint32_t> ticks{0};
    std::atomic<uint32_t> minDtUs{0};
    std::atomic<uint32_t> maxDtUs{0};
    std::atomic<uint32_t> lateTicks{0};
    std::atomic<uint32_t> maxLatenessUs{0};
    std::atomic<uint32_t> hidQueued{0};
    std::atomic<uint32_t> hidBusy{0};
    std::atomic<uint32_t> hidRejected{0};
    std::atomic<uint32_t> hidDrops{0};
    std::atomic<uint32_t> hidUnmountedTicks{0};
    std::atomic<uint32_t> hidMaxBusyStreak{0};
    std::atomic<uint32_t> hidMaxPendingAgeUs{0};
    std::atomic<uint32_t> hidMaxPendingAbs{0};
    std::atomic<uint32_t> hidMaxQueuedAgeUs{0}; // interval between queued reports, NOT completion
    std::atomic<uint32_t> hidReadyAfterBusy{0}; // readiness recovery, NOT completion
    std::atomic<uint32_t> hidTransferCompleted{0}; // valid ONLY with optional Arduino-core hook
    std::atomic<uint32_t> hidTransferFailed{0};    // valid ONLY with optional Arduino-core hook
    std::atomic<uint32_t> schedulerMissedSlots{0};
    std::atomic<uint32_t> warmStarts{0};
    std::atomic<uint32_t> springStarts{0};
    std::atomic<uint32_t> watchdogActive{0};
};
DRAM_ATTR EngineDiagnosticCounters g_engineDiag;
// Consistent per-second diagnostic snapshot. All payload values are atomic;
// sequence marks an in-progress publication. Core 0 retries on concurrent write.
static std::atomic<uint32_t> g_r32DiagSequence{0};
struct R32DiagSnapshot {
    uint32_t ticks, minDtUs, maxDtUs, lateTicks, maxLatenessUs;
    uint32_t hidQueued, hidBusy, hidRejected, hidDrops, hidUnmountedTicks;
    uint32_t hidMaxBusyStreak, hidMaxPendingAgeUs, hidMaxPendingAbs;
    uint32_t warmStarts, springStarts, watchdogActive;
    uint32_t schedulerMissedSlots, hidReadyAfterBusy, hidMaxQueuedAgeUs;
    uint32_t hidTransferCompleted, hidTransferFailed;
};

static bool r32ReadDiagSnapshot(R32DiagSnapshot& s) {
    for (unsigned attempt=0; attempt<4; ++attempt) {
        const uint32_t seq0 = g_r32DiagSequence.load(std::memory_order_acquire);
        if (seq0 & 1u) continue;
        s.ticks=g_engineDiag.ticks.load(std::memory_order_relaxed);
        s.minDtUs=g_engineDiag.minDtUs.load(std::memory_order_relaxed);
        s.maxDtUs=g_engineDiag.maxDtUs.load(std::memory_order_relaxed);
        s.lateTicks=g_engineDiag.lateTicks.load(std::memory_order_relaxed);
        s.maxLatenessUs=g_engineDiag.maxLatenessUs.load(std::memory_order_relaxed);
        s.hidQueued=g_engineDiag.hidQueued.load(std::memory_order_relaxed);
        s.hidBusy=g_engineDiag.hidBusy.load(std::memory_order_relaxed);
        s.hidRejected=g_engineDiag.hidRejected.load(std::memory_order_relaxed);
        s.hidDrops=g_engineDiag.hidDrops.load(std::memory_order_relaxed);
        s.hidUnmountedTicks=g_engineDiag.hidUnmountedTicks.load(std::memory_order_relaxed);
        s.hidMaxBusyStreak=g_engineDiag.hidMaxBusyStreak.load(std::memory_order_relaxed);
        s.hidMaxPendingAgeUs=g_engineDiag.hidMaxPendingAgeUs.load(std::memory_order_relaxed);
        s.hidMaxPendingAbs=g_engineDiag.hidMaxPendingAbs.load(std::memory_order_relaxed);
        s.warmStarts=g_engineDiag.warmStarts.load(std::memory_order_relaxed);
        s.springStarts=g_engineDiag.springStarts.load(std::memory_order_relaxed);
        s.watchdogActive=g_engineDiag.watchdogActive.load(std::memory_order_relaxed);
        s.schedulerMissedSlots=g_engineDiag.schedulerMissedSlots.load(std::memory_order_relaxed);
        s.hidReadyAfterBusy=g_engineDiag.hidReadyAfterBusy.load(std::memory_order_relaxed);
        s.hidMaxQueuedAgeUs=g_engineDiag.hidMaxQueuedAgeUs.load(std::memory_order_relaxed);
        // callback hook (optional): cumulative, not part of the 1-second window
        s.hidTransferCompleted=g_engineDiag.hidTransferCompleted.load(std::memory_order_relaxed);
        s.hidTransferFailed=g_engineDiag.hidTransferFailed.load(std::memory_order_relaxed);
        std::atomic_thread_fence(std::memory_order_acquire);
        if (seq0 == g_r32DiagSequence.load(std::memory_order_acquire)) return true;
    }
    return false;
}

// The stock Arduino-ESP32 USBHID.cpp owns tud_hid_report_complete_cb() itself.
// Defining that callback here causes duplicate symbols. Optional core adapter is
// not supplied here; leave disabled unless installing a compatible core adapter.
#if R32_USB_COMPLETION_HOOK
extern "C" void recoil_hid_transfer_complete(uint8_t instance, uint8_t const* report, uint16_t len) {
    if (instance == 0 && report && len == sizeof(MouseReport16) + 1 && report[0] == REPORT_ID_MOUSE)
        g_engineDiag.hidTransferCompleted.fetch_add(1, std::memory_order_relaxed);
}
extern "C" void recoil_hid_transfer_failed(uint8_t instance) {
    if (instance == 0) g_engineDiag.hidTransferFailed.fetch_add(1, std::memory_order_relaxed);
}
#endif

// Engine emits the CURRENT indication state, not a lossy mailbox of past events.
// Core 0 alone owns WS2812 and chooses the highest-priority visible indication.
enum EngineLedState : uint8_t {
    ENGINE_LED_IDLE = 0,
    ENGINE_LED_CLOSE = 1,
    ENGINE_LED_LONG = 2
};
DRAM_ATTR std::atomic<uint8_t> g_engineLedState{ENGINE_LED_IDLE};
// The engine waits for both FreeRTOS tasks to exist before starting GPIO/HID work.
DRAM_ATTR std::atomic<bool> g_tasksReady{false};

TaskHandle_t engineTaskHandle  = NULL;
TaskHandle_t controlTaskHandle = NULL;
esp_timer_handle_t engineWakeTimer = nullptr;
std::atomic<bool> g_engineFault{false};
std::atomic<bool> g_flashSaveRequested{false};
std::atomic<bool> g_flashSaveGranted{false};

// Timer service runs on Core 0 in the pinned build; this callback never sends HID.
void engineWakeCallback(void*) {
    if (engineTaskHandle != nullptr) xTaskNotifyGive(engineTaskHandle);
}

// Only a short final tail is busy-waited. The engine blocks between ticks so
// Core 1 idle/system tasks remain schedulable and its idle watchdog stays enabled.
void waitForEngineDeadline(uint64_t deadlineUs) {
    uint64_t now = esp_timer_get_time();
    if (deadlineUs > now + 75ULL) {
        (void)ulTaskNotifyTake(pdTRUE, 0); // discard an obsolete wake notification
        const esp_err_t armed = esp_timer_start_once(engineWakeTimer, deadlineUs - now - 50ULL);
        if (armed != ESP_OK) {
            g_engineLedState.store(ENGINE_LED_IDLE, std::memory_order_relaxed);
            g_engineFault.store(true, std::memory_order_release);
            vTaskSuspend(nullptr); // fail closed; ControlTask displays the fault
            return;
        }
        (void)ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
    }
    while ((now = esp_timer_get_time()) < deadlineUs) {
        if (deadlineUs - now > 4ULL) esp_rom_delay_us(1);
    }
}

