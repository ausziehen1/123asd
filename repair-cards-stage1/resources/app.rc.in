#include <windows.h>
101 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/qr.ico"
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/resources/client.manifest"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
#ifdef RESOURCE_DLL
FILETYPE VFT_DLL
#else
FILETYPE VFT_APP
#endif
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "ProductName", "Repair Cards\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo" BEGIN VALUE "Translation", 0x409, 1200 END
END
